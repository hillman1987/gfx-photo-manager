{
  "_readme": "把 roots 改成你自己的照片目录（可填多个），然后执行 npm run scan 重建索引。excludeDirs 里的目录会被跳过。",
  "roots": [
    "/Users/你的用户名/Pictures/GFX"
  ],
  "excludeDirs": [
    "node_modules",
    ".git",
    "Photos Library.photoslibrary",
    "Thumbnails",
    ".photolibrary",
    "@eaDir"
  ],
  "maxDepth": 12,
  "thumb": {
    "width": 640,
    "quality": 82
  },
  "concurrency": 6
}
