{
  "name": "gfx-photo-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fujifilm GFX100S 本地照片管理：EXIF 索引 + 分类筛选 + 快速检索",
  "scripts": {
    "scan": "node scripts/scan.mjs",
    "serve": "node scripts/serve.mjs",
    "start": "node scripts/scan.mjs && node scripts/serve.mjs",
    "mock": "node scripts/mock.mjs --set-root",
    "demo": "node scripts/mock.mjs --set-root && node scripts/serve.mjs",
    "probe": "node scripts/probe.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "jsdom": "^24.1.3"
  }
}
